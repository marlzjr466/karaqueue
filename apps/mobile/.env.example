# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
# Public — safe to expose to the browser/mobile client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Bypasses Row Level Security.
# Never expose to the browser, mobile app, or client bundles.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# YouTube Data API
# ─────────────────────────────────────────────
# SECRET — server-only. Used only in API routes, never in client code.
YOUTUBE_API_KEY=

# ─────────────────────────────────────────────
# Stripe (payment provider)
# ─────────────────────────────────────────────
# SECRET — server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public — safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
